{
  "name": "tiny-planner",
  "version": "1.0.2",
  "private": true,
  "description": "A local task, project and expense planner for Obsidian.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "test:ui": "node scripts/test.mjs ui",
    "check": "npm run validate:release && npm run typecheck && npm run build && npm test",
    "test:browser": "node tests/ui.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/*.{ts,js,cjs}\" \"scripts/*.mjs\" styles.css \"*.json\"",
    "test:perf": "node scripts/performance.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:browser:container": "node scripts/browser-container.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "version:release": "node scripts/version.mjs",
    "screenshots": "npm run build && node tests/previews.cjs",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "obsidian": "1.13.1",
    "playwright": "1.61.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "rrule": "2.8.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
